{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-antigravity-auth@beta"
  ],
  "provider": {
    "openai": {
      "models": {
        "gpt-5.2": {
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "minimal": {
              "reasoningEffort": "minimal"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "high"
            }
          }
        },
        "gpt-5.2-codex": {
          "variants": {
            "none": {
              "reasoningEffort": "none"
            },
            "minimal": {
              "reasoningEffort": "minimal"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "high"
            }
          }
        }
      }
    },
    "google": {
      "models": {
        "antigravity-OpenCode-opus-4-5-thinking": {
          "name": "OpenCode Opus 4.5 Thinking"
        },
        "antigravity-OpenCode-sonnet": {
          "name": "OpenCode Sonnet"
        },
        "antigravity-gemini-3-pro": {
          "name": "Gemini 3 Pro",
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            }
          }
        },
        "antigravity-gemini-3-flash": {
          "name": "Gemini 3 Flash",
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            }
          }
        }
      }
    },
    "github-copilot": {
      "models": {
        "claude-opus-4.5": {
          "name": "Claude Opus 4.5 (Copilot)",
          "variants": {
            "high": {},
            "max": {}
          }
        },
        "claude-sonnet-4.5": {
          "name": "Claude Sonnet 4.5 (Copilot)",
          "variants": {
            "high": {},
            "max": {}
          }
        }
      }
    }
  },
  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "enabled": true
    }
  }
}
